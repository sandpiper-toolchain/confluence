[Unit]
Description=Confluence MQTT node
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
User=oak
WorkingDirectory=/home/oak/confluence
ExecStart=/home/oak/.lagunavenv/bin/python -u confluence_daemon.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
